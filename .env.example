# Tallynest environment template
# Never commit real secrets.

NODE_ENV=development
WEBAPP_URL=http://localhost:3000
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-better-auth-secret
CRON_SECRET=dev-only-cron-secret
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tallynest?schema=public
REDIS_URL=redis://localhost:6379

AUTHZED_ENABLED=true
AUTHZED_ENDPOINT=localhost:50051
AUTHZED_TOKEN=dev-authzed-token
AUTHZED_SYSTEM_KEY=tallynest
AUTHZED_INSECURE=true
AUTHZED_CONSISTENCY=fully_consistent
AUTHZED_DATABASE_PASSWORD=

CUBEJS_API_URL=http://localhost:4000
CUBEJS_API_SECRET=dev-cube-secret
CUBEJS_JWT_ISSUER=tallynest-web
CUBEJS_JWT_AUDIENCE=tallynest-cube

MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Tallynest
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE_ENABLED=0
SMTP_USER=smtpUser
SMTP_PASSWORD=smtpPassword

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=0

EMAIL_VERIFICATION_DISABLED=1
PASSWORD_RESET_DISABLED=1

GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZUREAD_CLIENT_ID=
AZUREAD_CLIENT_SECRET=
AZUREAD_TENANT_ID=

NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URL=
AIRTABLE_CLIENT_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

OPENAI_API_KEY=
AI_PROVIDER=openai-compatible
AI_MODEL=ci-model
AI_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
AI_OPENAI_COMPATIBLE_API_KEY=ci-dummy-key

PRIVACY_URL=
TERMS_URL=
IMPRINT_URL=
IMPRINT_ADDRESS=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=

TELEMETRY_DISABLED=1
DANGEROUSLY_ALLOW_WEBHOOK_INTERNAL_URLS=0
TRUSTED_PROXY_HOP_COUNT=1

HUB_API_URL=http://localhost:8080
HUB_API_KEY=dev-api-key
HUB_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hub?schema=public
FORMBRICKS_WORKSPACE_ID=
FORMBRICKS_APP_URL=
