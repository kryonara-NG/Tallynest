# Tallynest Environment Variables

# App Setup
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development-secret-key-tallynest-32-chars-minimum"
WEBAPP_URL="http://localhost:3000"

# Database
DATABASE_URL="postgresql://tallynest:tallynest@localhost:5432/tallynest?schema=public"

# Optional Email & Storage Providers (Tallynest Provider Abstraction)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user"
# SMTP_PASSWORD="password"
# S3_BUCKET="tallynest-storage"
# S3_REGION="us-east-1"
